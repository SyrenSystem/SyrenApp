context.properties = { core.daemon = false log.level = 3 }
context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.* = support/libspa-support
}
context.modules = [
    { name = libpipewire-module-rt flags = [ ifexists nofail ] }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
    { name = libpipewire-module-rtp-sink
      args = {
        remote.name = "@REMOTE@"
        source.ip = "@LOCAL_IP@"
        destination.ip = "@PI_IP@"
        destination.port = 46000
        net.mtu = 1280
        sess.name = "SyrenSystem Live"
        sess.media = audio
        sess.min-ptime = 2.5
        sess.max-ptime = 2.5
        sess.latency.msec = 2.5
        audio.format = S16BE
        audio.rate = 48000
        audio.channels = 2
        audio.position = [ FL FR ]
        stream.props = {
            node.name = SyrenSystem_Live
            node.description = "SyrenSystem Live"
            media.class = Audio/Sink
            node.virtual = true
            priority.session = 0
            node.always-process = true
            node.force-quantum = 128
            rtp.ptime = 2.5
            rtp.payload = 127
            sess.sap.announce = false
        }
      }
    }
]
