#!/bin/sh
set -eu

server_host="${SYREN_SERVER_HOST:-127.0.0.1}"
server_port="${SYREN_SERVER_PORT:-4953}"
virtual_sink="SyrenSystem"
# Prefer the control script installed next to this sender so a stale copy on PATH cannot shadow it.
sender_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
audio_control="$sender_directory/../../bin/syren-audio-control"
if [ ! -x "$audio_control" ]; then
  audio_control="syren-audio-control"
fi
capture_fifo="${XDG_RUNTIME_DIR:-/tmp}/syren-laptop-audio-$$.fifo"
cleanup() {
  for child_pid in "${record_pid:-}" "${network_pid:-}" "${sleep_pid:-}"; do
    if [ -n "$child_pid" ]; then
      kill "$child_pid" 2>/dev/null || true
    fi
  done
  rm -f "$capture_fifo"
}
trap cleanup EXIT
trap 'exit 0' INT TERM
netcat_help="$(nc -h 2>&1 || true)"
case "$netcat_help" in
  *-N*) netcat_close_options="-N" ;;
  *) netcat_close_options="-q 1" ;;
esac

apply_pending=1
restore_only=0
restore_marker="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/syren-sender-restore-once"
if [ -f "$restore_marker" ]; then
  restore_only=1
  rm -f "$restore_marker"
fi
while true; do
  if ! sink_state="$("$audio_control" ensure-sink)"; then
    printf 'Could not create the %s sink.\n' "$virtual_sink" >&2
    exit 1
  fi
  # Routing is applied once at start and again only after the sink had to be recreated.
  # A restore after RTP skips only the first pass, since the routes were just put back by hand.
  if [ "$restore_only" = 1 ]; then
    restore_only=0
    apply_pending=0
  elif [ "$apply_pending" = 1 ] || [ "$sink_state" = created ]; then
    "$audio_control" apply || printf 'Could not apply the laptop audio state.\n' >&2
    apply_pending=0
  fi
  # A fifo lets the loop stop pw-record when the connection drops, since an idle sink never writes and would keep it alive.
  rm -f "$capture_fifo"
  mkfifo -m 600 "$capture_fifo"
  pw-record \
    --raw \
    --rate 48000 \
    --channels 2 \
    --format s16 \
    --latency 20ms \
    -P '{ "stream.capture.sink": true, "node.dont-fallback": true, "node.dont-reconnect": true }' \
    --target "$virtual_sink" - > "$capture_fifo" &
  record_pid=$!
  nc $netcat_close_options "$server_host" "$server_port" < "$capture_fifo" &
  network_pid=$!
  wait "$network_pid" || true
  network_pid=""
  kill "$record_pid" 2>/dev/null || true
  wait "$record_pid" 2>/dev/null || true
  rm -f "$capture_fifo"
  sleep 1 &
  sleep_pid=$!
  wait "$sleep_pid" || true
  sleep_pid=""
done
